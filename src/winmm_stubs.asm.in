; Exports of the system winmm.dll, generated by CMakeLists.txt from winmm_exports.txt. Each stub jumps to the
; system function, whose address loader.cpp stores while the loader is being loaded.

.data
PUBLIC gmodpp_winmm_table
gmodpp_winmm_table QWORD @WINMM_COUNT@ DUP(0)

.const
PUBLIC gmodpp_winmm_count
gmodpp_winmm_count DWORD @WINMM_COUNT@
ALIGN 8
PUBLIC gmodpp_winmm_names
gmodpp_winmm_names LABEL QWORD
@WINMM_NAMES@
@WINMM_STRINGS@

.code
WINMM_STUB MACRO index
gmodpp_winmm_&index& PROC
    jmp gmodpp_winmm_table[index * 8]
gmodpp_winmm_&index& ENDP
ENDM

@WINMM_STUBS@
END
