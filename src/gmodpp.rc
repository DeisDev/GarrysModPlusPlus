#include <winver.h>

#include "gmodpp_version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION GMODPP_VERSION_NUMBERS
PRODUCTVERSION GMODPP_VERSION_NUMBERS
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#if GMODPP_VERSION_PRERELEASE
FILEFLAGS VS_FF_PRERELEASE
#else
FILEFLAGS 0
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "GarrysMod++ shader API"
            VALUE "FileVersion", GMODPP_VERSION
            VALUE "ProductName", "GarrysMod++"
            VALUE "ProductVersion", GMODPP_VERSION
            VALUE "OriginalFilename", "gmodpp.dll"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
