// GarrysMod++ G-buffer twin of GMod's teeth_ps20b (shaders/twins, Phase 3 of the native port).
// Source: Source SDK 2013 mp/src/materialsystem/stdshaders/teeth_ps2x.fxc at 7309a5f (Source 1 SDK License), which
// matches GMod's combos. Change: the GBUFFER_TWIN output. The vertex shader's light and mouth darkening (vertAtten)
// are left out: ray tracing shades the inside of the mouth.
//====== Copyright © 1996-2004, Valve Corporation, All rights reserved. =======
//
// Purpose: 
//
//=============================================================================

// STATIC: "CONVERT_TO_SRGB"				"0..1"	[ps20b][= g_pHardwareConfig->NeedsShaderSRGBConversion()] [PC]
// STATIC: "CONVERT_TO_SRGB"				"0..1"	[ps30][= g_pHardwareConfig->NeedsShaderSRGBConversion()] [PC]
// STATIC: "CONVERT_TO_SRGB"				"0..0"	[= 0] [XBOX]

// DYNAMIC: "PIXELFOGTYPE"					"0..1"
// DYNAMIC: "WRITE_DEPTH_TO_DESTALPHA"		"0..1"	[ps20b] [PC]
// DYNAMIC: "WRITE_DEPTH_TO_DESTALPHA"		"0..0"	[ps20b] [XBOX]
// DYNAMIC: "WRITE_DEPTH_TO_DESTALPHA"		"0..1"	[ps30]


#if defined( SHADER_MODEL_PS_2_0 )
#	define WRITE_DEPTH_TO_DESTALPHA 0
#endif

#include "common_ps_fxc.h"
#include "shader_constant_register_map.h"

sampler BaseTextureSampler			: register( s0 );

const float4 g_FogParams				: register( PSREG_FOG_PARAMS );
const float4 g_EyePos_SpecExponent		: register( PSREG_EYEPOS_SPEC_EXPONENT );

struct PS_INPUT
{
	float2 baseTexCoord				: TEXCOORD0;
	float3 vertAtten				: TEXCOORD1;
	
	float4 worldPos_projPosZ		: TEXCOORD7;		// Necessary for pixel fog
};

#if GBUFFER_TWIN
// The G-buffer layout of shaders/twins: albedo, normal (none here: the lighting takes it from depth), emissive, flags
// (or the world position for forward twins).
struct GBufferTwinOutput
{
	float4 albedo	: COLOR0;
	float4 normal	: COLOR1;
	float4 emissive	: COLOR2;
	float4 flags	: COLOR3;
};

GBufferTwinOutput main( PS_INPUT i )
{
	float4 baseSample = tex2D( BaseTextureSampler, i.baseTexCoord );
	GBufferTwinOutput twin;
	twin.albedo = baseSample;
	twin.normal = float4( 0, 0, 0, baseSample.a );
	twin.emissive = float4( 0, 0, 0, 0 );
#if FORWARD_TWIN
	twin.flags = float4( i.worldPos_projPosZ.xyz, baseSample.a );
#else
	twin.flags = float4( 1, 1, 1, baseSample.a );
#endif
	return twin;
}
#else
float4 main( PS_INPUT i ) : COLOR
{
	float4 baseSample = tex2D( BaseTextureSampler, i.baseTexCoord );
	
	float4 result;
	result.xyz = baseSample.xyz * i.vertAtten;
	result.a = baseSample.a;
	
	
	float fogFactor = CalcPixelFogFactor( PIXELFOGTYPE, g_FogParams, g_EyePos_SpecExponent.z, i.worldPos_projPosZ.z, i.worldPos_projPosZ.w );
	return FinalOutput( result, fogFactor, PIXELFOGTYPE, TONEMAP_SCALE_LINEAR, (WRITE_DEPTH_TO_DESTALPHA != 0), i.worldPos_projPosZ.w );
}
#endif // GBUFFER_TWIN
